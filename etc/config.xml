<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
  <default>
    <punchout2go_punchout>
      <hyvacompat>
        <rest_store_code></rest_store_code>
        <api_key></api_key>
      </hyvacompat>
    </punchout2go_punchout>
    <dev>
      <js>
        <minify_exclude>
          <!-- punchout-transfer.js imports ./punchout-session.js by its unminified name -->
          <punchout2go_hyvacompat>/Punchout2Go_HyvaCompat/</punchout2go_hyvacompat>
        </minify_exclude>
      </js>
    </dev>
  </default>
</config>
